{
  "name": "audora",
  "version": "2.1.1",
  "description": "Desktop Music Downloader & Library Manager",
  "homepage": "https://github.com/utkarsh-wadalkar/Audora",
  "author": "Utkarsh Wadalkar",
  "license": "SEE LICENSE IN LICENSE.txt",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test:electron": "node --test electron/*.test.js scripts/build-all.test.cjs src/lib/*.test.mjs src/store/*.test.mjs",
    "test:setup": "playwright test tests/setup-wizard.spec.ts",
    "smoke": "node electron/smoke-packaged.js",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run dist",
    "dist": "node scripts/build-all.cjs"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.6",
    "zustand": "^4.5.0",
    "axios": "^1.21.1",
    "lucide-react": "^0.344.0",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.8",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "minimatch@>=7 <11": "11.0.9"
  },
  "build": {
    "appId": "com.audora.app",
    "productName": "Audora",
    "publish": {
      "provider": "github",
      "owner": "utkarsh-wadalkar",
      "repo": "Audora"
    },
    "icon": "assets/audoralogo.ico",
    "directories": {
      "output": "../.cache/BUILD/dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/audoralogo.ico"
    },
    "linux": {
      "icon": "assets/audoralogo.png",
      "maintainer": "Utkarsh Wadalkar <utkarsh-wadalkar@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "nsis": {
      "include": "electron/preserve-legacy-data.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE.txt",
      "installerIcon": "assets/audoralogo.ico",
      "uninstallerIcon": "assets/audoralogo.ico",
      "installerHeaderIcon": "assets/audoralogo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
